local function showAlertText(text, color)
    speedAlertText.Text = text
    speedAlertFrame.BackgroundColor3 = color or Color3.fromRGB(220,30,30)
    if not alertVisible then
        alertVisible = true
        speedAlertFrame.Visible = true
        TweenService:Create(speedAlertFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
            Position = UDim2.new(0.5,-190,0,8)
        }):Play()
    end
    if alertHideTask then task.cancel(alertHideTask) end
    alertHideTask = task.delay(3, function()
        TweenService:Create(speedAlertFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            Position = UDim2.new(0.5,-190,0,-60)
        }):Play()
        task.wait(0.35)
        speedAlertFrame.Visible = false
        alertVisible = false
    end)
end

