local function updateF1Bar()
    for _, c in ipairs(f1Scroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    f1Rows = {}

    local sorted = getOrderedPlayers()

    local leaderLaps = #sorted > 0 and (playerLaps[sorted[1].UserId] or 0) or 0
    if totalLaps > 0 then
        f1LapInfo.Text = string.format('LAP <font color="#FFFFFF"><b>%d</b></font>/%d', leaderLaps, totalLaps)
    else
        f1LapInfo.Text = string.format('LAP <font color="#FFFFFF"><b>%d</b></font>', leaderLaps)
    end

    for pos, plr in ipairs(sorted) do
        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1,-4,0,26)
        row.BackgroundColor3 = pos == 1 and Color3.fromRGB(36,30,46) or Color3.fromRGB(22,22,30)
        row.BackgroundTransparency = 0.25
        row.BorderSizePixel  = 0
        row.LayoutOrder      = pos
        row.ClipsDescendants = true
        row.ZIndex           = 17
        row.Parent           = f1Scroll
        Instance.new("UICorner", row).CornerRadius = UDim.new(0,4)

        local posL = Instance.new("TextLabel")
        posL.Size            = UDim2.new(0,24,1,0)
        posL.Position        = UDim2.new(0,2,0,0)
        posL.BackgroundTransparency = 1
        posL.Text            = tostring(pos)
        posL.TextColor3      = Color3.fromRGB(200,200,210)
        posL.Font            = Enum.Font.GothamBold
        posL.TextSize        = 13
        posL.ZIndex          = 18
        posL.Parent          = row

        local nameL = Instance.new("TextLabel")
        nameL.Size           = UDim2.new(0,56,1,0)
        nameL.Position       = UDim2.new(0,30,0,0)
        nameL.BackgroundTransparency = 1
        nameL.Text           = abbr3(plr)
        nameL.TextColor3     = Color3.fromRGB(255,255,255)
        nameL.Font           = Enum.Font.GothamBlack
        nameL.TextSize       = 16
        nameL.TextXAlignment = Enum.TextXAlignment.Left
        nameL.ZIndex         = 18
        nameL.Parent         = row

        -- GAP: "Leader" para el primero; el resto muestra su diferencia
        local gapText, gapColor = formatGap(metaGapTracker, plr.UserId)
        local shownText, shownColor
        if isInPits and isInPits(plr.UserId) then
            shownText, shownColor = "PIT", Color3.fromRGB(90,160,255)
        elseif pos == 1 then
            shownText, shownColor = "Leader", Color3.fromRGB(255,255,255)
        else
            shownText = gapText
            if gapText == "--" or gapText == "GAP" then
                shownColor = Color3.fromRGB(150,150,160)
            elseif gapColor == Color3.fromRGB(255,140,60) then
                shownColor = Color3.fromRGB(255,170,90)
            else
                shownColor = Color3.fromRGB(255,255,255)
            end
            if gapText == "GAP" then shownText = "--" end
        end
        local gapL = Instance.new("TextLabel")
        gapL.Size             = UDim2.new(1,-118,1,0)
        gapL.Position         = UDim2.new(0,90,0,0)
        gapL.BackgroundTransparency = 1
        gapL.Text             = shownText
        gapL.TextColor3       = shownColor
        gapL.Font             = Enum.Font.GothamBold
        gapL.TextSize         = 14
        gapL.TextXAlignment   = Enum.TextXAlignment.Right
        gapL.ZIndex           = 18
        gapL.Parent           = row

        -- neumatico asignado (S / M / H)
        local tireInfo = getTireInfo and getTireInfo(plr.UserId) or nil
        if tireInfo then
            local tl = Instance.new("TextLabel")
            tl.Size = UDim2.new(0,20,1,0)
            tl.Position = UDim2.new(1,-24,0,0)
            tl.BackgroundTransparency = 1
            tl.Text = tireInfo.letter
            tl.TextColor3 = TIRE_COLORS_BAR[tireInfo.letter] or tireInfo.color
            tl.Font = Enum.Font.GothamBlack
            tl.TextSize = 15
            tl.ZIndex = 18
            tl.Parent = row
        end

        f1Rows[plr.UserId] = row
    end
    f1Scroll.CanvasSize = UDim2.new(0,0,0, f1ListLayout.AbsoluteContentSize.Y + 6)
end

