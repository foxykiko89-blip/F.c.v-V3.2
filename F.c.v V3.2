-- ============================================================
-- DETECCION DE CHOQUES ENTRE AUTOS (solo autos de Brookhaven)
-- Heuristica: dos autos con jugadores sentados se consideran en
-- colision cuando sus centros quedan muy cerca entre si Y al menos
-- uno de los dos sufre una caida brusca de velocidad (mismo criterio
-- que ya usa el sistema para detectar impactos individuales). El
-- resultado de cada piloto se clasifica segun la orientacion/rotacion
-- de su auto tras el impacto:
--   - "volcado"   -> el auto quedo boca abajo o muy inclinado
--   - "trompeado" -> el auto gira rapido sobre si mismo (trompo)
--   - "empujado"  -> el auto fue desplazado sin volcar ni trompear
-- ============================================================
-- Envuelto en su propia funcion (IIFE) para que sus variables
-- locales no se sumen al limite de 200 locales de buildF1MSystem.
;(function()
local crashPrevVel = {} -- velocidad (studs/seg) del frame anterior, SOLO para este sistema

-- GetBoundingBox() recorre TODAS las partes del modelo; hacerlo cada
-- frame para cada auto es caro. El tamano de un auto no cambia
-- mientras se conduce, asi que se calcula una sola vez por modelo.
local vehicleRadiusCache = setmetatable({}, { __mode = "k" }) -- claves debiles: se limpia solo si el modelo se destruye

local function getVehicleRadius(model)
    local cached = vehicleRadiusCache[model]
    if cached then return cached end
    local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
    local radius = (ok and size) and (math.max(size.X, size.Z) / 2) or 8
    vehicleRadiusCache[model] = radius
    return radius
end

local function classifyOutcome(model, refPart)
    if not refPart then return "empujado" end
    local upDot = refPart.CFrame.UpVector:Dot(Vector3.new(0,1,0))
    if upDot < 0.45 then
        return "volcado"
    end
    local ok, angVel = pcall(function() return refPart.AssemblyAngularVelocity end)
    if ok and angVel and angVel.Magnitude > 3.5 then
        return "trompeado"
    end
    return "empujado"
end

-- ============================================================
-- REPETICIONES: grabacion y reproduccion de choques
-- Se guarda un historial corto (pre-roll) de posiciones de CADA auto
-- en todo momento, y cuando se detecta un choque se congela una copia
-- de ese historial + unos segundos mas (post-roll) grabados despues,
-- junto con un "fantasma" (clon sin colision) de cada auto para poder
-- recrear el momento con la camara despues.
-- ============================================================
local HISTORY_SECONDS    = 4   -- pre-roll que se guarda siempre
local POST_ROLL_SECONDS  = 3   -- cuanto se sigue grabando tras el choque
local vehicleHistory     = {}  -- [uid] = { {t=, cf=}, ... }

-- Carpeta oculta donde viven los fantasmas guardados de cada repeticion
local ReplayStorage = Instance.new("Folder")
ReplayStorage.Name   = "F1MReplayStorage"
ReplayStorage.Parent = workspace

local function pushHistory(uid, cframe)
    local hist = vehicleHistory[uid]
    if not hist then
        hist = {}
        vehicleHistory[uid] = hist
    end
    table.insert(hist, { t = tick(), cf = cframe })
    local cutoff = tick() - HISTORY_SECONDS
    while #hist > 0 and hist[1].t < cutoff do
        table.remove(hist, 1)
    end
end

local function copyHistory(uid)
    local hist = vehicleHistory[uid]
    local out = {}
    if hist then
        for _, f in ipairs(hist) do
            table.insert(out, { t = f.t, cf = f.cf })
        end
    end
    return out
end

-- Clona el modelo del auto como "fantasma": sin colision, anclado, y
-- sin scripts, guardado lejos del mapa hasta que se use en una repeticion
local function cloneGhostModel(model)
    local ok, clone = pcall(function() return model:Clone() end)
    if not ok or not clone then return nil end
    for _, desc in ipairs(clone:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.Anchored    = true
            desc.CanCollide  = false
            desc.CanTouch    = false
            pcall(function() desc.CanQuery = false end)
        elseif desc:IsA("Script") or desc:IsA("LocalScript") then
            desc:Destroy()
        end
    end
    clone.Parent = ReplayStorage
    pcall(function() clone:PivotTo(CFrame.new(0, -3000, 0)) end)
    return clone
end

-- Inicia la captura de una repeticion: congela el pre-roll ya grabado
-- y sigue grabando unos segundos mas en segundo plano antes de marcar
-- la repeticion como lista para verse.
local function startReplayCapture(plrA, dataA, plrB, dataB, text)
    local entry = {
        id      = crashIdCounter,
        text    = text,
        status  = "recording",
        framesA = copyHistory(plrA.UserId),
        framesB = copyHistory(plrB.UserId),
        ghostA  = cloneGhostModel(dataA.model),
        ghostB  = cloneGhostModel(dataB.model),
    }
    crashIdCounter = crashIdCounter + 1
    table.insert(crashLogEntries, entry)

    -- limitar cuantas repeticiones se guardan a la vez para no acumular
    -- clones infinitos en memoria
    if #crashLogEntries > 25 then
        local old = table.remove(crashLogEntries, 1)
        if old then
            if old.ghostA then old.ghostA:Destroy() end
            if old.ghostB then old.ghostB:Destroy() end
        end
    end

    if updateCrashPanel then updateCrashPanel() end

    task.spawn(function()
        local endTime = tick() + POST_ROLL_SECONDS
        while tick() < endTime do
            local plrAstill = Players:GetPlayerByUserId(plrA.UserId)
            local plrBstill = Players:GetPlayerByUserId(plrB.UserId)
            if plrAstill then
                local m = getPlayerVehicleModel(plrAstill)
                local r = m and getVehicleReferencePart(m)
                if r then table.insert(entry.framesA, { t = tick(), cf = r.CFrame }) end
            end
            if plrBstill then
                local m = getPlayerVehicleModel(plrBstill)
                local r = m and getVehicleReferencePart(m)
                if r then table.insert(entry.framesB, { t = tick(), cf = r.CFrame }) end
            end
            task.wait(0.1)
        end
        entry.status = "ready"
        if updateCrashPanel then updateCrashPanel() end
    end)
end

-- Repeticion de un solo auto (pase por un cuadro CC): se guarda dentro
-- del registro CC (logEntry.replay) y se ve con "Ver repeticion".
startCCReplayCapture = function(plr, model, logEntry, text)
    if not plr or not model or not logEntry then return end
    local entry = {
        text    = text,
        status  = "recording",
        framesA = copyHistory(plr.UserId),
        framesB = {},
        ghostA  = cloneGhostModel(model),
        ghostB  = nil,
    }
    logEntry.replay = entry
    if updateCCLogPanel then updateCCLogPanel() end

    task.spawn(function()
        local endTime = tick() + POST_ROLL_SECONDS
        while tick() < endTime do
            local still = Players:GetPlayerByUserId(plr.UserId)
            if still then
                local m = getPlayerVehicleModel(still)
                local r = m and getVehicleReferencePart(m)
                if r then table.insert(entry.framesA, { t = tick(), cf = r.CFrame }) end
            end
            task.wait(0.1)
        end
        entry.status = "ready"
        if updateCCLogPanel then updateCCLogPanel() end
    end)
end

