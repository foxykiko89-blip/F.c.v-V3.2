-- ---------- deteccion ----------
RunService.Heartbeat:Connect(function()
    if #limitBoxes == 0 and not pitBox then return end

    for _, plr in ipairs(getAllPlayers()) do
        local uid  = plr.UserId
        local char = plr.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hrp and isInVehicleSeat(hum) then
            local pos = hrp.Position

            -- limites de pista
            for _, e in ipairs(limitBoxes) do
                local key = e.id .. "_" .. uid
                local inside, swept = boxHit("l" .. key, pos, e.box)
                if (inside or swept) and not limitState[key] then
                    limitState[key] = inside
                    if tick() - (limitLast[uid] or 0) > 3 then
                        limitLast[uid] = tick()
                        limitCount[uid] = (limitCount[uid] or 0) + 1
                        showAlertText("LIMITE DE PISTA - " .. dn(plr) .. " (" .. limitCount[uid] .. ")", Color3.fromRGB(230,140,20))
                        logEvent("LIMITE DE PISTA: " .. dn(plr) .. " (" .. limitCount[uid] .. ")")
                        sendDiscordEvent(":no_entry: **LIMITE DE PISTA** - **" .. dn(plr) .. "** (" .. limitCount[uid] .. ")")
                        if activeTab == "Pista" then updatePistaPanel() end
                    end
                elseif not inside and limitState[key] then
                    limitState[key] = false
                end
            end

            -- pits
            if pitBox then
                local inside = isInsideBox(pos, pitBox)
                if inside and not pitState[uid] then
                    pitState[uid] = tick()
                    logEvent("PITS ENTRADA: " .. dn(plr))
                elseif inside and pitState[uid] then
                    if pitSpeedMax > 0 and tick() - (pitSpeedWarn[uid] or 0) > 4 then
                        local spd = getBrookhavenVehicleSpeed(plr)
                        if spd > pitSpeedMax then
                            pitSpeedWarn[uid] = tick()
                            showAlertText("EXCESO EN PITS: " .. dn(plr) .. " - " .. formatSpeed(spd) .. " (lim. " .. formatSpeed(pitSpeedMax) .. ")", Color3.fromRGB(30,100,210))
                        end
                    end
                elseif not inside and pitState[uid] then
                    local dur = tick() - pitState[uid]
                    pitState[uid] = nil
                    local d = pitStops[uid] or { n = 0, last = 0 }
                    d.n = d.n + 1
                    d.last = dur
                    pitStops[uid] = d
                    if tireFreshHook then tireFreshHook(uid) end
                    showAlertText(string.format("PIT STOP - %s  %.1fs", dn(plr), dur), Color3.fromRGB(30,100,210))
                    logEvent(string.format("PIT STOP: %s - %.1fs (parada %d)", dn(plr), dur, d.n))
                    sendDiscordEvent(string.format(":wrench: **PIT STOP** - **%s** %.1fs (parada %d)", dn(plr), dur, d.n))
                    if activeTab == "Pista" then updatePistaPanel() end
                end
            end
        end
    end
end)
end)() -- fin del IIFE de Pista

