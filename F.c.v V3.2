-- Alerta de desgaste: cuando las vueltas del neumatico llegan al limite
-- configurado (Config > Neumaticos) se muestra una alerta como la de velocidad.
local tireAlertQueue = {}
local tireAlertRunning = false
local function pushTireAlert(text)
    table.insert(tireAlertQueue, text)
    if tireAlertRunning then return end
    tireAlertRunning = true
    task.spawn(function()
        while #tireAlertQueue > 0 do
            local msg = table.remove(tireAlertQueue, 1)
            showAlertText(msg, Color3.fromRGB(230,140,20))
            task.wait(3.6)
        end
        tireAlertRunning = false
    end)
end

task.spawn(function()
    while true do
        task.wait(1)
        for _, plr in ipairs(getAllPlayers()) do
            local t = playerTires[plr.UserId]
            if t then
                local limit = tireLife[t.compound] or 0
                local n = tireLaps(plr.UserId)
                if limit > 0 and n >= limit then
                    if not t.alerted then
                        t.alerted = true
                        local nm = TIRES[t.compound].name
                        pushTireAlert("Neumaticos " .. nm .. " desgastados - " .. dn(plr))
                        logEvent("Neumaticos " .. nm .. " desgastados: " .. dn(plr))
                        sendDiscordEvent(":warning: **NEUMATICOS " .. nm:upper() .. " DESGASTADOS** - **" .. dn(plr) .. "** (" .. n .. " vueltas)")
                    end
                else
                    t.alerted = false
                end
            end
        end
    end
end)
end)() -- fin del IIFE de Neumaticos

