discordBtn.MouseButton1Click:Connect(function()
    discordBtn.Text     = "Enviando..."
    discordBtn.BackgroundColor3 = Color3.fromRGB(60,60,140)
    discordStatus.Text  = ""

    -- Construir posiciones finales
    local posLines = ""
    local plrsSorted = getAllPlayers()
    table.sort(plrsSorted, function(a,b)
        return (playerLaps[a.UserId] or 0) > (playerLaps[b.UserId] or 0)
    end)
    local medals = {"1.", "2.", "3."}
    for i, plr in ipairs(plrsSorted) do
        local lap  = playerLaps[plr.UserId] or 0
        local medal = medals[i] or (tostring(i) .. ".")
        posLines = posLines .. medal .. " **" .. dn(plr) .. "** - " .. lap .. " vueltas\n"
    end

    -- Mejores tiempos
    local timeLines = ""
    local timePlrs = {}
    for _, plr in ipairs(getAllPlayers()) do
        if playerLapTimes[plr.UserId] then
            table.insert(timePlrs, plr)
        end
    end
    table.sort(timePlrs, function(a,b)
        return (playerLapTimes[a.UserId] or 999) < (playerLapTimes[b.UserId] or 999)
    end)
    if #timePlrs > 0 then
        for i, plr in ipairs(timePlrs) do
            if i > 5 then break end
            timeLines = timeLines .. tostring(i) .. ". **" .. dn(plr) .. "** - " .. formatTime(playerLapTimes[plr.UserId]) .. "\n"
        end
    else
        timeLines = "Sin tiempos registrados"
    end

    -- Velocidades maximas
    local velLines = ""
    local velListB = {}
    for _, plr in ipairs(getAllPlayers()) do
        table.insert(velListB, {name=dn(plr), spd=maxVehicleSpeeds[plr.UserId] or 0})
    end
    table.sort(velListB, function(a,b) return a.spd > b.spd end)
    for i, v in ipairs(velListB) do
        if i > 5 then break end
        velLines = velLines .. v.name .. " - " .. formatSpeed(v.spd) .. "\n"
    end
    if velLines == "" then velLines = "Sin datos de velocidad" end

    -- Log de eventos (maximo 20 para no exceder limite de Discord)
    local logLines = ""
    local startIdx = math.max(1, #raceLog - 19)
    for i = startIdx, #raceLog do
        logLines = logLines .. raceLog[i] .. "\n"
    end
    if logLines == "" then logLines = "Sin eventos registrados en esta sesion" end

    -- Duracion de la sesion
    local durStr = "No iniciada"
    if raceStartTime then
        local el = tick() - raceStartTime
        local hh = math.floor(el/3600)
        local mm = math.floor((el%3600)/60)
        local ss = math.floor(el%60)
        durStr = string.format("%dh %dm %ds", hh, mm, ss)
    end

    local pilotsStr = ""
    for _, plr in ipairs(getAllPlayers()) do
        pilotsStr = pilotsStr .. dn(plr) .. ", "
    end
    if #pilotsStr > 2 then pilotsStr = pilotsStr:sub(1,-3) end

    -- Construir payload JSON del embed de Discord
    local payload = '{'
        .. '"username":"F1M Race System",'
        .. '"avatar_url":"https://i.imgur.com/4M34hi2.png",'
        .. '"embeds":[{'
        .. '"title":":checkered_flag:  INFORME DE CARRERA - F1M Race System",'
        .. '"color":14177041,'
        .. '"fields":['
        .. '{"name":":trophy: Posiciones Finales","value":"' .. posLines:gsub('"','\\"'):gsub('\n','\\n') .. '","inline":false},'
        .. '{"name":":stopwatch: Qualy","value":"' .. timeLines:gsub('"','\\"'):gsub('\n','\\n') .. '","inline":true},'
        .. '{"name":":racing_car: Vel. Max. por Piloto","value":"' .. velLines:gsub('"','\\"'):gsub('\n','\\n') .. '","inline":true},'
        .. '{"name":":notepad_spiral: Cronica de la Carrera","value":"```\\n' .. logLines:gsub('"','\\"'):gsub('\n','\\n') .. '```","inline":false},'
        .. '{"name":":busts_in_silhouette: Pilotos","value":"' .. pilotsStr:gsub('"','\\"') .. '","inline":true},'
        .. '{"name":":timer: Duracion","value":"' .. durStr .. '","inline":true}'
        .. '],'
        .. '"footer":{"text":"F1M Race System - Brookhaven"}'
        .. '}]}'

    -- Enviar via HttpService (requiere executor con soporte http)
    local success, err = pcall(function()
        if DISCORD_WEBHOOK == "" then error("Primero configura el webhook (boton Webhook)") end
        local res = request({
            Url     = DISCORD_WEBHOOK,
            Method  = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body    = payload
        })
        if res and res.StatusCode and res.StatusCode >= 400 then
            error("Discord respondio " .. tostring(res.StatusCode))
        end
    end)

    if success then
        discordBtn.Text             = "Enviar Informe a Discord"
        discordBtn.BackgroundColor3 = Color3.fromRGB(88,101,242)
        discordStatus.Text          = "Enviado correctamente!"
        discordStatus.TextColor3    = Color3.fromRGB(100,255,140)
        task.delay(3, function()
            discordStatus.Text = ""
        end)
    else
        discordBtn.Text             = "Enviar Informe a Discord"
        discordBtn.BackgroundColor3 = Color3.fromRGB(88,101,242)
        discordStatus.Text          = "Error: " .. tostring(err):sub(1,50)
        discordStatus.TextColor3    = Color3.fromRGB(255,100,100)
    end
end)

