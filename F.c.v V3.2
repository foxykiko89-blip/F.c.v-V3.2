local function isInsideBox(pos, box)
    if not box or not pos then return false end
    local rel = box.CFrame:PointToObjectSpace(pos)
    local s   = box.Size
    return math.abs(rel.X) <= s.X / 2
       and math.abs(rel.Y) <= s.Y / 2
       and math.abs(rel.Z) <= s.Z / 2
end

-- Deteccion por trayectoria: un auto rapido (o con lag) puede "saltar" un
-- cuadro delgado entre dos chequeos. segmentHitsBox revisa si el tramo
-- entre la posicion anterior y la actual atraviesa el cuadro.
local function slabClip(o, d, h, tmin, tmax)
    if math.abs(d) < 1e-6 then
        if o < -h or o > h then return nil end
        return tmin, tmax
    end
    local t1, t2 = (-h - o) / d, (h - o) / d
    if t1 > t2 then t1, t2 = t2, t1 end
    if t1 > tmin then tmin = t1 end
    if t2 < tmax then tmax = t2 end
    if tmin > tmax then return nil end
    return tmin, tmax
end

local function segmentHitsBox(a, b, box)
    local cf = box.CFrame
    local p0 = cf:PointToObjectSpace(a)
    local p1 = cf:PointToObjectSpace(b)
    local d  = p1 - p0
    local h  = box.Size * 0.5
    local tmin, tmax = 0, 1
    tmin, tmax = slabClip(p0.X, d.X, h.X, tmin, tmax)
    if not tmin then return false end
    tmin, tmax = slabClip(p0.Y, d.Y, h.Y, tmin, tmax)
    if not tmin then return false end
    tmin, tmax = slabClip(p0.Z, d.Z, h.Z, tmin, tmax)
    return tmin ~= nil
end

local lastPosTag = {} -- [tag] = { pos=, t= }
-- Devuelve (dentro, atraveso_entre_chequeos)
local function boxHit(tag, pos, box)
    if not box or not pos then return false, false end
    local last = lastPosTag[tag]
    local now = tick()
    lastPosTag[tag] = { pos = pos, t = now }
    local inside = isInsideBox(pos, box)
    local swept = false
    if not inside and last and (now - last.t) < 0.6 and (pos - last.pos).Magnitude < 600 then
        swept = segmentHitsBox(last.pos, pos, box)
    end
    return inside, swept
end

-- Encuentra el Model del auto (Brookhaven) en el que esta sentado un
-- Player, junto con su asiento. Devuelve nil si no esta en un auto.
-- IMPORTANTE: los autos de Brookhaven pueden tener sub-modelos
-- anidados (ej. un modelo pequeno solo para el chasis/asiento dentro
-- de uno mas grande que incluye toda la carroceria y efectos como el
-- del Nitro/Boost). Por eso subimos hasta el modelo MAS ALTO antes de
-- workspace, en vez de quedarnos con el primer ancestro Model que
-- encontremos (que podria ser solo una parte incompleta del auto).
-- Solo nos interesan autos: Brookhaven usa VehicleSeat para vehiculos
-- (autos, motos, etc.) y Seat para asientos normales (bancas, sillas).
-- Filtrar por VehicleSeat evita que todos los sistemas de deteccion
-- (velocidad, boost, CC, choques) procesen jugadores que solo estan
-- sentados en una banca, ahorrando trabajo innecesario cada frame.
local function isInVehicleSeat(hum)
    return hum ~= nil and hum.SeatPart ~= nil and hum.SeatPart:IsA("VehicleSeat")
end

local function getPlayerVehicleModel(plr)
    local char = plr.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not isInVehicleSeat(hum) then return nil end

    local current = hum.SeatPart
    local topModel = nil
    local depth = 0
    while current and current ~= workspace and depth < 60 do
        if current:IsA("Model") then
            topModel = current
        end
        current = current.Parent
        depth = depth + 1
    end

    return topModel, hum.SeatPart
end

-- Devuelve un BasePart de referencia (centro aproximado) de un modelo de auto
local function getVehicleReferencePart(model)
    if not model then return nil end
    return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
end

-- ============================================================
-- ORDEN DE POSICIONES DE CARRERA (estilo F1)
-- raceOrder es una lista ordenada de UserIds. Se sincroniza con
-- los jugadores actuales (agrega nuevos al final, quita los que
-- se fueron) y normalmente se reordena por numero de vueltas.
-- ============================================================
local function syncRaceOrder()
    local current = Players:GetPlayers()
    local currentIds = {}
    for _, plr in ipairs(current) do
        currentIds[plr.UserId] = true
    end

    -- Quitar de raceOrder a los que ya no estan
    for i = #raceOrder, 1, -1 do
        if not currentIds[raceOrder[i]] then
            table.remove(raceOrder, i)
        end
    end

    -- Agregar al final los jugadores nuevos que no estan en raceOrder
    local inOrder = {}
    for _, uid in ipairs(raceOrder) do inOrder[uid] = true end
    for _, plr in ipairs(current) do
        if not inOrder[plr.UserId] then
            table.insert(raceOrder, plr.UserId)
        end
    end
end

-- Reordena raceOrder por vueltas (de mayor a menor). Cuando dos
-- pilotos tienen las mismas vueltas, gana el que cruzo esa vuelta
-- PRIMERO (menor playerLapTimestamp). Esto es determinista y no
-- depende de que table.sort sea estable (en Lua no lo es), que era
-- la causa de que la barra de posiciones se viera mal antes.
local function reorderByLaps()
    syncRaceOrder()
    table.sort(raceOrder, function(a, b)
        local la = playerLaps[a] or 0
        local lb = playerLaps[b] or 0
        if la ~= lb then
            return la > lb
        end
        local ta = playerLapTimestamp[a] or math.huge
        local tb = playerLapTimestamp[b] or math.huge
        if ta ~= tb then
            return ta < tb
        end
        return a < b -- ultimo desempate, puramente para ser deterministas
    end)
end

-- Devuelve la lista de Player ordenada segun raceOrder (estilo F1)
local function getOrderedPlayers()
    syncRaceOrder()
    local result = {}
    for _, uid in ipairs(raceOrder) do
        local plr = Players:GetPlayerByUserId(uid)
        if plr then table.insert(result, plr) end
    end
    return result
end

-- ============================================================
-- VELOCIDAD NATIVA BROOKHAVEN
-- IMPORTANTE: un IntValue de Roblox SOLO guarda numeros enteros,
-- por lo que si la velocidad real es 70.3, un IntValue jamas podra
-- contener ese decimal (Roblox lo redondea automaticamente al
-- guardarlo). Por eso aqui SIEMPRE se prioriza buscar un NumberValue
-- primero (que si guarda decimales con precision exacta), y solo se
-- usa un IntValue como ultimo recurso si no se encuentra nada mejor.
-- ============================================================
-- ============================================================
-- CACHE de resolucion de velocidad: la busqueda completa (pasos 1-4,
-- que puede recorrer TODOS los descendientes del modelo) solo se
-- hace la PRIMERA vez que vemos cada auto. Las siguientes llamadas
-- solo leen el valor ya encontrado (o usan 0 si no se encontro nada),
-- en vez de repetir el escaneo completo 60 veces por segundo.
-- ============================================================
local speedSourceCache = {} -- [uid] = { model = Model, inst = ValueInstance|nil }

local function resolveSpeedSource(seat, model)
    local possibleNames = {
        "Speed", "CurrentSpeed", "DisplaySpeed", "SpeedKMH", "SpeedoMeter",
        "Speedometer", "SpeedValue", "Velocidad", "KMH", "Kmh"
    }

    for _, nm in ipairs(possibleNames) do
        local v = seat:FindFirstChild(nm)
        if v and v:IsA("NumberValue") then return v end
    end

    if model then
        for _, nm in ipairs(possibleNames) do
            local v = model:FindFirstChild(nm)
            if v and v:IsA("NumberValue") then return v end
        end
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("NumberValue") then
                local n = desc.Name:lower()
                if n:find("speed") or n:find("vel") or n == "kmh" then return desc end
            end
        end
    end

    for _, nm in ipairs(possibleNames) do
        local v = seat:FindFirstChild(nm)
        if v and v:IsA("IntValue") then return v end
    end
    if model then
        for _, nm in ipairs(possibleNames) do
            local v = model:FindFirstChild(nm)
            if v and v:IsA("IntValue") then return v end
        end
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("IntValue") then
                local n = desc.Name:lower()
                if n:find("speed") or n:find("vel") or n == "kmh" then return desc end
            end
        end
    end

    for _, v in pairs(seat:GetChildren()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n = v.Name:lower()
            if n:find("speed") or n:find("vel") then return v end
        end
    end

    return nil
end

local function getBrookhavenVehicleSpeed(player)
    local char = player.Character
    if not char then return 0 end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not isInVehicleSeat(hum) then return 0 end
    local seat = hum.SeatPart
    local model = seat:FindFirstAncestorOfClass("Model")

    local uid = player.UserId
    local cached = speedSourceCache[uid]
    if cached and cached.model == model then
        if cached.inst and cached.inst.Parent then
            return math.abs(cached.inst.Value)
        elseif cached.inst == nil then
            return 0 -- ya sabemos que este auto no expone ningun valor de velocidad
        end
    end

    local inst = resolveSpeedSource(seat, model)
    speedSourceCache[uid] = { model = model, inst = inst }
    if inst then
        return math.abs(inst.Value)
    end
    return 0
end

-- ============================================================
-- SUSPENSION Y DERIVA (pestana "Extras")
-- Mismo patron que la velocidad: buscamos un value con un nombre
-- conocido dentro del asiento o del modelo del auto, y lo cacheamos
-- por auto para no repetir el escaneo completo cada vez.
-- ============================================================
local suspensionCache = {} -- [uid] = { model = Model, inst = ValueInstance|nil }
local driftCache      = {} -- [uid] = { model = Model, inst = ValueInstance|nil }

local function resolveNamedValue(seat, model, possibleNames)
    for _, nm in ipairs(possibleNames) do
        local v = seat:FindFirstChild(nm)
        if v and (v:IsA("NumberValue") or v:IsA("IntValue") or v:IsA("StringValue")) then return v end
    end
    if model then
        for _, nm in ipairs(possibleNames) do
            local v = model:FindFirstChild(nm)
            if v and (v:IsA("NumberValue") or v:IsA("IntValue") or v:IsA("StringValue")) then return v end
        end
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("NumberValue") or desc:IsA("IntValue") or desc:IsA("StringValue") then
                local n = desc.Name:lower()
                for _, nm in ipairs(possibleNames) do
                    if n == nm:lower() then return desc end
                end
            end
        end
    end
    return nil
end

local SUSPENSION_NAMES = {
    "Suspension", "Suspencion", "Suspensión", "SuspensionStiffness",
    "SuspensionTravel", "SuspensionHeight", "Susp", "SuspensionSetting"
}
local DRIFT_NAMES = {
    "Drift", "DriftValue", "Deriva", "DriftFactor", "DriftGrip",
    "Traction", "Grip", "TireGrip"
}

-- Busqueda extendida: ademas de los nombres exactos, mira Atributos y
-- cualquier Value / Atributo cuyo nombre CONTENGA una palabra clave.
local SUSPENSION_KEYS = { "suspen", "suspens", "susp" }
local DRIFT_KEYS      = { "drift", "deriv" }

local function nameHasKey(name, keys)
    local n = name:lower()
    for _, k in ipairs(keys) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function isValueObj(o)
    return o:IsA("NumberValue") or o:IsA("IntValue") or o:IsA("StringValue")
end

-- Devuelve una "fuente": { inst=Value } o { inst=Instance, attr="Nombre" }
local function findExtraSource(seat, model, names, keys)
    local v = resolveNamedValue(seat, model, names)
    if v then return { inst = v } end
    local roots = { seat }
    if model then table.insert(roots, model) end
    for _, root in ipairs(roots) do
        local okA, attrs = pcall(function() return root:GetAttributes() end)
        if okA and attrs then
            for an, _ in pairs(attrs) do
                if nameHasKey(an, keys) then return { inst = root, attr = an } end
            end
        end
    end
    if model then
        local n = 0
        for _, d in ipairs(model:GetDescendants()) do
            n = n + 1
            if n > 3000 then break end
            if isValueObj(d) and nameHasKey(d.Name, keys) then return { inst = d } end
            local okA, attrs = pcall(function() return d:GetAttributes() end)
            if okA and attrs then
                for an, _ in pairs(attrs) do
                    if nameHasKey(an, keys) then return { inst = d, attr = an } end
                end
            end
        end
    end
    return nil
end

local function readExtraSource(src)
    if not src or not src.inst or not src.inst.Parent then return nil end
    if src.attr then
        local ok, v = pcall(function() return src.inst:GetAttribute(src.attr) end)
        return ok and v or nil
    end
    return src.inst.Value
end

-- Respaldo para suspension: promedio de la longitud libre de los resortes
-- (SpringConstraint) del auto, si el juego los usa.
local function springFallback(model)
    if not model then return nil end
    local sum, n = 0, 0
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("SpringConstraint") then
            sum = sum + d.FreeLength
            n = n + 1
        end
    end
    if n > 0 then return sum / n end
    return nil
end

local function getExtraValue(player, cache, names, keys, withSpring)
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not isInVehicleSeat(hum) then return nil end
    local seat = hum.SeatPart
    local model = getPlayerVehicleModel(player) or seat:FindFirstAncestorOfClass("Model")

    local uid = player.UserId
    local c = cache[uid]
    if c and c.model == model then
        if c.src and c.src.inst and c.src.inst.Parent then
            return readExtraSource(c.src)
        elseif c.src == nil and tick() - c.t < 4 then
            return withSpring and springFallback(model) or nil
        end
    end
    local src = findExtraSource(seat, model, names, keys)
    cache[uid] = { model = model, src = src, t = tick() }
    if src then return readExtraSource(src) end
    return withSpring and springFallback(model) or nil
end

-- Brookhaven guarda estos datos como ATRIBUTOS del modelo del auto
-- (Vehicles.<Usuario>Car): SuspensionLevel y DriftStrength.
local function readCarAttr(player, attrName)
    local model = getPlayerVehicleModel(player)
    if not model then return nil end
    local ok, v = pcall(function() return model:GetAttribute(attrName) end)
    if ok then return v end
    return nil
end

local function getBrookhavenSuspension(player)
    local v = readCarAttr(player, "SuspensionLevel")
    if v ~= nil then return v end
    return getExtraValue(player, suspensionCache, SUSPENSION_NAMES, SUSPENSION_KEYS, false)
end

local function getBrookhavenDrift(player)
    local v = readCarAttr(player, "DriftStrength")
    if v ~= nil then return v end
    return getExtraValue(player, driftCache, DRIFT_NAMES, DRIFT_KEYS, false)
end

