local ccActiveTab = nil
local ccTabPanels = {}

local function createCCTab(name, order)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0,150,0,28)
    btn.BackgroundColor3 = Color3.fromRGB(35,35,50)
    btn.Text             = name
    btn.TextColor3       = Color3.fromRGB(200,200,200)
    btn.Font             = Enum.Font.GothamSemibold
    btn.TextSize         = 12
    btn.BorderSizePixel  = 0
    btn.LayoutOrder      = order
    btn.ZIndex           = 22
    btn.Parent           = CCTabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)

    local panel = Instance.new("Frame")
    panel.Size               = UDim2.new(1,0,1,0)
    panel.BackgroundTransparency = 1
    panel.Visible            = false
    panel.ZIndex             = 22
    panel.Parent             = CCContentFrame

    ccTabPanels[name] = { btn = btn, panel = panel }
    return btn, panel
end

local function switchCCTab(name)
    for tname, t in pairs(ccTabPanels) do
        t.panel.Visible = (tname == name)
        if tname == name then
            t.btn.BackgroundColor3 = Color3.fromRGB(230,230,230)
            t.btn.TextColor3       = Color3.fromRGB(20,20,20)
        else
            t.btn.BackgroundColor3 = Color3.fromRGB(35,35,50)
            t.btn.TextColor3       = Color3.fromRGB(200,200,200)
        end
    end
    ccActiveTab = name
    if name == "Colocar CC" and updateCCListPanel then updateCCListPanel() end
    if name == "Registros CC" and updateCCLogPanel then updateCCLogPanel() end
end

