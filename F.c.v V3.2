-- Enviar evento a Discord EN TIEMPO REAL usando request() de Delta.
-- Se encola para no superar el limite de velocidad de la API de Discord.
local function sendDiscordEvent(message)
    if DISCORD_WEBHOOK == "" then return end -- sin webhook configurado
    table.insert(discordQueue, message)
    if discordSending then return end
    discordSending = true
    task.spawn(function()
        while #discordQueue > 0 do
            local msg = table.remove(discordQueue, 1)
            local ts = ""
            if raceStartTime then
                local el = tick() - raceStartTime
                ts = string.format(" `[%d:%02d]`", math.floor(el/60), math.floor(el%60))
            end
            local payload = '{"username":"F1M Race System",'
                .. '"avatar_url":"https://i.imgur.com/4M34hi2.png",'
                .. '"embeds":[{"description":"' .. msg:gsub('"','\\"'):gsub('\n','\\n') .. ts .. '",'
                .. '"color":14177041,'
                .. '"footer":{"text":"F1M Race System \xE2\x80\x94 Brookhaven"}}]}'
            pcall(function()
                request({
                    Url     = DISCORD_WEBHOOK,
                    Method  = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body    = payload
                })
            end)
            task.wait(2.2)
        end
        discordSending = false
    end)
end

