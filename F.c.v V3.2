local function playLapReplay(entry)
    if replayPlaying then return end
    local lap = entry.lap
    local frames = entry.framesA
    if not lap or not entry.ghostA or not frames or #frames < 2 then return end
    replayPlaying = true

    Dashboard.Visible = false
    F1MButton.Visible = false
    CCButton.Visible  = false
    ReplayExitBtn.Visible = true
    ReplayLabel.Visible   = true
    ReplayLabel.Text      = "REPETICION - QUALY P1"

    -- HUD
    hudPos.Text  = "1"
    hudName.Text = string.upper(lap.name)
    hudTime.Text = formatTime(0)
    if lap.tire then
        hudTire.Visible = true
        hudTire.Text = lap.tire.letter
        hudTire.TextColor3 = lap.tire.color
        hudTireStroke.Color = lap.tire.color
    else
        hudTire.Visible = false
    end
    local nSec = lap.secs and #lap.secs or 0
    for i = 1, 3 do
        hudBars[i].Visible = (i <= nSec)
        hudSecLabels[i].Visible = (i <= nSec)
        hudBars[i].BackgroundColor3 = GREY_COL
        hudSecLabels[i].Text = "S" .. i
        hudSecLabels[i].TextColor3 = GREY_COL
        if nSec > 0 then
            hudBars[i].Size = UDim2.new(1/nSec, -10, 0, 6)
            hudBars[i].Position = UDim2.new((i-1)/nSec, 7, 0, 90)
            hudSecLabels[i].Size = UDim2.new(1/nSec, -10, 0, 18)
            hudSecLabels[i].Position = UDim2.new((i-1)/nSec, 7, 0, 98)
        end
    end
    LapHud.Visible = true

    local ghost = entry.ghostA:Clone()
    ghost.Parent = workspace
    local offset = entry.offset or CFrame.new()

    local cam = workspace.CurrentCamera
    local prevCamType = cam.CameraType
    cam.CameraType = Enum.CameraType.Scriptable

    local stopRequested = false
    local exitConn = ReplayExitBtn.MouseButton1Click:Connect(function() stopRequested = true end)

    local startTick = tick()
    local idx = 1
    local dir = Vector3.new(0,0,-1)
    local camCF = nil
    local reached = {}
    local endTime = lap.time

    while not stopRequested do
        local el = tick() - startTick
        if el > endTime + 2 then break end
        local tt = math.min(el, endTime)

        while idx < #frames - 1 and frames[idx + 1].t <= tt do idx = idx + 1 end
        local f1, f2 = frames[idx], frames[math.min(idx + 1, #frames)]
        local span = f2.t - f1.t
        local alpha = (span > 0.0001) and math.clamp((tt - f1.t) / span, 0, 1) or 0
        local cf = f1.cf:Lerp(f2.cf, alpha)
        pcall(function() ghost:PivotTo(cf * offset) end)

        local d = f2.cf.Position - f1.cf.Position
        d = Vector3.new(d.X, 0, d.Z)
        if d.Magnitude > 0.05 then dir = dir:Lerp(d.Unit, 0.12) end
        if dir.Magnitude < 0.01 then dir = Vector3.new(0,0,-1) end
        local pos = cf.Position
        local target = CFrame.lookAt(pos - dir.Unit * 20 + Vector3.new(0, 8, 0), pos + Vector3.new(0, 2, 0))
        camCF = camCF and camCF:Lerp(target, 0.2) or target
        cam.CFrame = camCF

        hudTime.Text = formatTime(tt)
        if lap.secs then
            local acc = 0
            for i = 1, nSec do
                acc = acc + lap.secs[i]
                if tt >= acc and not reached[i] then
                    reached[i] = true
                    local col = lap.colors[i] or YELLOW_COL
                    hudBars[i].BackgroundColor3 = col
                    hudSecLabels[i].TextColor3 = col
                    hudSecLabels[i].Text = "S" .. i .. "  " .. string.format("%.3f", lap.secs[i])
                end
            end
        end
        RunService.RenderStepped:Wait()
    end
    if not stopRequested then hudTime.Text = formatTime(lap.time) end

    exitConn:Disconnect()
    ghost:Destroy()
    cam.CameraType = (prevCamType == Enum.CameraType.Scriptable) and Enum.CameraType.Custom or prevCamType
    LapHud.Visible = false
    F1MButton.Visible = true
    CCButton.Visible  = true
    ReplayExitBtn.Visible = false
    ReplayLabel.Visible   = false
    replayPlaying = false
end

-- ---------- grabacion de vueltas ----------
local function resetQualyRecords()
    qlRec = {}
    qlOverall = {}
    qlPB = {}
    if qlLeader and qlLeader.ghost then qlLeader.ghost:Destroy() end
    qlLeader = nil
end

local function finishQualyRecords()
    qlRec = {}
    local L = qlLeader
    if not L then return end
    qlLeader = nil -- el fantasma pasa a pertenecer a la repeticion guardada

    local colors = {}
    if L.secs then
        for i, v in ipairs(L.secs) do
            local pb = qlPB[L.uid] and qlPB[L.uid][i]
            if qlOverall[i] and v <= qlOverall[i] + 0.0005 then colors[i] = PURPLE_COL
            elseif pb and v <= pb + 0.0005 then colors[i] = GREEN_COL
            else colors[i] = YELLOW_COL end
        end
    end

    local entry = {
        id      = crashIdCounter,
        text    = "QUALY P1 - " .. L.name .. " - " .. formatTime(L.time),
        status  = "ready",
        framesA = L.frames,
        framesB = {},
        ghostA  = L.ghost,
        ghostB  = nil,
        offset  = L.offset,
        lap     = { uid = L.uid, name = L.name, time = L.time, secs = L.secs, colors = colors, tire = L.tire },
    }
    crashIdCounter = crashIdCounter + 1
    table.insert(crashLogEntries, entry)
    if #crashLogEntries > 25 then
        local old = table.remove(crashLogEntries, 1)
        if old then
            if old.ghostA then old.ghostA:Destroy() end
            if old.ghostB then old.ghostB:Destroy() end
        end
    end
    qlOverall = {}
    qlPB = {}
    if updateCrashPanel then updateCrashPanel() end

    local cam = workspace.CurrentCamera
    if cam and cam.CameraType ~= Enum.CameraType.Scriptable and not replayPlaying then
        task.spawn(playReplay, entry)
    end
end

qualyLapHook = function(plr, event, elapsed)
    if event == "reset" then resetQualyRecords(); return end
    if event == "session_end" then finishQualyRecords(); return end
    if not plr then return end
    local uid = plr.UserId

    if event == "begin" then
        local cps = {}
        if sectorBoxCyan   then table.insert(cps, sectorBoxCyan)   end
        if sectorBoxYellow then table.insert(cps, sectorBoxYellow) end
        if sectorBoxRed    then table.insert(cps, sectorBoxRed)    end
        qlRec[uid] = { t0 = tick(), frames = {}, cps = cps, nextCp = 1, marks = {} }
        return
    end

    if event == "end" then
        local rec = qlRec[uid]
        qlRec[uid] = nil
        if not rec or not elapsed or elapsed < 10 then return end

        local secs = nil
        if #rec.cps > 0 and rec.nextCp > #rec.cps then
            local bounds = {}
            for i = 1, #rec.cps do bounds[i] = rec.marks[i] end
            if #rec.cps < 3 then bounds[#bounds + 1] = elapsed end
            secs = {}
            local prev = 0
            for i, b in ipairs(bounds) do
                secs[i] = math.max(b - prev, 0)
                prev = b
            end
            qlPB[uid] = qlPB[uid] or {}
            for i, v in ipairs(secs) do
                if not qlOverall[i] or v < qlOverall[i] then qlOverall[i] = v end
                if not qlPB[uid][i] or v < qlPB[uid][i] then qlPB[uid][i] = v end
            end
        end

        if not qlLeader or elapsed < qlLeader.time then
            local model = getPlayerVehicleModel(plr)
            local ref = model and getVehicleReferencePart(model)
            local ghost = model and cloneGhostModel(model) or nil
            local offset = CFrame.new()
            if ghost and ref then
                pcall(function() offset = ref.CFrame:ToObjectSpace(model:GetPivot()) end)
            end
            if not ghost then ghost = makeFallbackGhost() end
            if qlLeader and qlLeader.ghost then qlLeader.ghost:Destroy() end
            local tire = nil
            if getTireInfo then tire = getTireInfo(uid) end
            qlLeader = {
                uid = uid, name = dn(plr), time = elapsed, frames = rec.frames,
                ghost = ghost, offset = offset, secs = secs, tire = tire,
            }
        end
    end
end

local qlAccum = 0
RunService.Heartbeat:Connect(function(dt)
    if not qualyActive then return end
    if next(qlRec) == nil then return end
    qlAccum = qlAccum + dt
    local sample = qlAccum >= 0.1
    if sample then qlAccum = 0 end
    for uid, rec in pairs(qlRec) do
        local plr = Players:GetPlayerByUserId(uid)
        local char = plr and plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local now = tick() - rec.t0
        if not hrp or now > 600 then
            qlRec[uid] = nil
        else
            if rec.nextCp <= #rec.cps then
                local ins, sw = boxHit("r" .. uid .. "_" .. rec.nextCp, hrp.Position, rec.cps[rec.nextCp])
                if ins or sw then
                    rec.marks[rec.nextCp] = now
                    rec.nextCp = rec.nextCp + 1
                end
            end
            if sample then
                local model = getPlayerVehicleModel(plr)
                local ref = model and getVehicleReferencePart(model)
                if ref then table.insert(rec.frames, { t = now, cf = ref.CFrame }) end
            end
        end
    end
end)

playReplay = function(entry)
    if entry.lap then return playLapReplay(entry) end
    if replayPlaying then return end
    if not entry.ghostA then return end
    if #entry.framesA == 0 then return end
    local hasB = entry.ghostB ~= nil and #entry.framesB > 0
    replayPlaying = true

    Dashboard.Visible = false
    F1MButton.Visible = false
    CCButton.Visible  = false
    ReplayExitBtn.Visible = true
    ReplayLabel.Visible   = true
    ReplayLabel.Text      = entry.text

    local ghostA = entry.ghostA:Clone()
    local ghostB = hasB and entry.ghostB:Clone() or nil
    for _, desc in ipairs(ghostA:GetDescendants()) do
        if desc:IsA("BasePart") then desc.Transparency = math.clamp(desc.Transparency + 0.35, 0, 0.9) end
    end
    if ghostB then
        for _, desc in ipairs(ghostB:GetDescendants()) do
            if desc:IsA("BasePart") then desc.Transparency = math.clamp(desc.Transparency + 0.35, 0, 0.9) end
        end
        ghostB.Parent = workspace
    end
    ghostA.Parent = workspace

    Camera.CameraType = Enum.CameraType.Scriptable

    local framesA, framesB = entry.framesA, entry.framesB
    local totalFrames = hasB and math.max(#framesA, #framesB) or #framesA
    local lastDir = nil

    local stopRequested = false
    local exitConn
    exitConn = ReplayExitBtn.MouseButton1Click:Connect(function()
        stopRequested = true
    end)

    for i = 1, totalFrames do
        if stopRequested then break end
        local fA = framesA[math.min(i, #framesA)]
        pcall(function() ghostA:PivotTo(fA.cf) end)
        if hasB then
            local fB = framesB[math.min(i, #framesB)]
            pcall(function() ghostB:PivotTo(fB.cf) end)

            -- Camara: por detras y arriba del punto medio entre los dos autos
            local midPoint = fA.cf.Position:Lerp(fB.cf.Position, 0.5)
            local back = (fA.cf.Position - fB.cf.Position)
            if back.Magnitude < 1 then back = Vector3.new(0,0,10) end
            back = back.Unit
            local camPos = midPoint + Vector3.new(0, 14, 0) + back * 22
            Camera.CFrame = CFrame.new(camPos, midPoint)
        else
            -- Un solo auto: camara detras (segun su direccion de avance) y arriba
            local pos = fA.cf.Position
            if i > 1 then
                local d = pos - framesA[i-1].cf.Position
                d = Vector3.new(d.X, 0, d.Z)
                if d.Magnitude > 0.5 then lastDir = d.Unit end
            end
            local dir = lastDir or Vector3.new(0,0,-1)
            Camera.CFrame = CFrame.new(pos - dir * 20 + Vector3.new(0, 9, 0), pos)
        end

        task.wait(0.1) -- reproduccion en camara lenta (~0.5x)
    end

    exitConn:Disconnect()
    ghostA:Destroy()
    if ghostB then ghostB:Destroy() end

    Camera.CameraType = Enum.CameraType.Custom
    F1MButton.Visible = true
    CCButton.Visible  = true
    ReplayExitBtn.Visible = false
    ReplayLabel.Visible   = false
    replayPlaying = false
end

