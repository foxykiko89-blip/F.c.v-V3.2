createTrackBox = function(color)
    local box = Instance.new("Part")
    box.Anchored     = true
    box.CanCollide   = false
    box.Transparency = 0.4
    box.Material     = Enum.Material.Neon
    box.BrickColor   = BrickColor.new(color)
    box.Size         = Vector3.new(20,12,6)
    for k in pairs(lastPosTag) do lastPosTag[k] = nil end
    local p = getCharacterPosition(LocalPlayer)
    box.CFrame       = p and CFrame.new(p + Vector3.new(0,1,0)) or CFrame.new(0,5,0)
    box.Parent       = workspace

    local sel = Instance.new("SelectionBox")
    sel.Adornee      = box
    sel.Color3       = color=="Bright green"  and Color3.fromRGB(0,255,0)
                    or color=="Bright orange" and Color3.fromRGB(255,140,0)
                    or color=="White"         and Color3.fromRGB(255,255,255)
                    or color=="Cyan"          and Color3.fromRGB(0,230,230)
                    or color=="Bright yellow" and Color3.fromRGB(255,220,0)
                    or color=="Really red"    and Color3.fromRGB(255,30,30)
                    or Color3.fromRGB(0,120,255)
    sel.LineThickness = 0.06
    sel.Parent        = box
    return box, sel
end


-- ============================================================
-- CONTROLES 3D DE LOS CUADROS (meta, qualy, sectores, CC)
-- Mover = flechas, Escalar = cuadritos, Rotar = anillos.
-- Rojo = eje X, Verde = eje Y (altura), Azul = eje Z.
-- ============================================================
;(function()
local AXIS_DEFS = {
    { faces = { Enum.NormalId.Right, Enum.NormalId.Left },  color = Color3.fromRGB(230,60,60),  axis = Enum.Axis.X },
    { faces = { Enum.NormalId.Top,   Enum.NormalId.Bottom },color = Color3.fromRGB(50,210,60),  axis = Enum.Axis.Y },
    { faces = { Enum.NormalId.Front, Enum.NormalId.Back },  color = Color3.fromRGB(40,90,255),  axis = Enum.Axis.Z },
}

local function snap(v, step)
    return math.floor(v / step + 0.5) * step
end

local startCF, startSize = nil, nil

-- Mientras se arrastra una flecha / cuadrito / anillo la camara se queda
-- quieta (si no, el dedo tambien gira la camara y es muy dificil de usar).
local camFrozen, camPrevType = false, nil
local function unfreezeCam()
    if not camFrozen then return end
    camFrozen = false
    local cam = workspace.CurrentCamera
    if cam then cam.CameraType = camPrevType or Enum.CameraType.Custom end
end
local function freezeCam()
    if camFrozen then return end
    local cam = workspace.CurrentCamera
    if not cam or cam.CameraType == Enum.CameraType.Scriptable then return end
    camPrevType = cam.CameraType
    camFrozen = true
    cam.CameraType = Enum.CameraType.Scriptable
end
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        unfreezeCam()
    end
end)

local function captureStart()
    freezeCam()
    local b = getActiveBox()
    if b then startCF = b.CFrame; startSize = b.Size end
end

local moveSet, scaleSet, rotSet = {}, {}, {}

for _, def in ipairs(AXIS_DEFS) do
    -- flechas (mover)
    local mh = Instance.new("Handles")
    mh.Style = Enum.HandlesStyle.Movement
    mh.Color3 = def.color
    mh.Faces = Faces.new(def.faces[1], def.faces[2])
    mh.Parent = ScreenGui
    mh.MouseButton1Down:Connect(captureStart)
    mh.MouseButton1Up:Connect(unfreezeCam)
    mh.MouseDrag:Connect(function(face, distance)
        local b = getActiveBox()
        if not b or not startCF then return end
        local d = snap(distance, 0.5)
        b.CFrame = startCF * CFrame.new(Vector3.FromNormalId(face) * d)
    end)
    table.insert(moveSet, mh)

    -- cuadritos (escalar)
    local sh = Instance.new("Handles")
    sh.Style = Enum.HandlesStyle.Resize
    sh.Color3 = def.color
    sh.Faces = Faces.new(def.faces[1], def.faces[2])
    sh.Parent = ScreenGui
    sh.MouseButton1Down:Connect(captureStart)
    sh.MouseButton1Up:Connect(unfreezeCam)
    sh.MouseDrag:Connect(function(face, distance)
        local b = getActiveBox()
        if not b or not startCF then return end
        local n = Vector3.FromNormalId(face)
        local an = Vector3.new(math.abs(n.X), math.abs(n.Y), math.abs(n.Z))
        local cur = startSize.X * an.X + startSize.Y * an.Y + startSize.Z * an.Z
        local d = math.max(snap(distance, 0.5), 1 - cur) -- minimo 1 stud
        b.Size = startSize + an * d
        b.CFrame = startCF * CFrame.new(n * (d / 2))
    end)
    table.insert(scaleSet, sh)

    -- anillos (rotar)
    local rh = Instance.new("ArcHandles")
    rh.Color3 = def.color
    rh.Axes = Axes.new(def.axis)
    rh.Parent = ScreenGui
    rh.MouseButton1Down:Connect(captureStart)
    rh.MouseButton1Up:Connect(unfreezeCam)
    rh.MouseDrag:Connect(function(axis, relativeAngle)
        local b = getActiveBox()
        if not b or not startCF then return end
        local a = snap(math.deg(relativeAngle), 1)
        b.CFrame = startCF * CFrame.fromAxisAngle(Vector3.FromAxis(axis), math.rad(a))
    end)
    table.insert(rotSet, rh)
end

