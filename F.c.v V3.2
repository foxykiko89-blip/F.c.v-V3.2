addCCLogEntry = function(userName, boxName)
    local logEntry = { id = ccLogIdCounter, userName = userName, boxName = boxName }
    table.insert(ccLogEntries, logEntry)
    ccLogIdCounter = ccLogIdCounter + 1
    if #ccLogEntries > 200 then
        local old = table.remove(ccLogEntries, 1)
        if old and old.replay and old.replay.ghostA then old.replay.ghostA:Destroy(); old.replay.ghostA = nil end
    end
    -- solo se conservan las repeticiones (fantasmas) de los ultimos 15 registros
    local withRep = 0
    for j = #ccLogEntries, 1, -1 do
        local r = ccLogEntries[j].replay
        if r and r.ghostA then
            withRep = withRep + 1
            if withRep > 15 then r.ghostA:Destroy(); r.ghostA = nil end
        end
    end
    updateCCLogPanel()
    return logEntry
end

