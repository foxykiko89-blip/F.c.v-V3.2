-- ============================================================
local function stopOnboard()
    if onboardConn then
        onboardConn:Disconnect()
        onboardConn = nil
    end
    onboardActive      = false
    OnboardHUD.Visible = false
    Camera.CameraType  = Enum.CameraType.Custom
    F1MButton.Visible  = true
end

local function startOnboard(index)
    local list = getAllPlayers()
    if #list == 0 then return end

    if index < 1 then index = #list end
    if index > #list then index = 1 end
    spectatingIndex = index

    local targetPlayer = list[spectatingIndex]

    hudName.Text = dn(targetPlayer)

    local pos = playerLaps[targetPlayer.UserId] or 0
    local sortedPos = 1
    for _, plr in ipairs(list) do
        if (playerLaps[plr.UserId] or 0) > pos then
            sortedPos = sortedPos + 1
        end
    end
    hudPos.Text = "P" .. sortedPos

    if onboardConn then
        onboardConn:Disconnect()
        onboardConn = nil
    end

    onboardActive      = true
    OnboardHUD.Visible = true
    F1MButton.Visible  = true
    Camera.CameraType  = Enum.CameraType.Scriptable

    onboardConn = RunService.RenderStepped:Connect(function()
        local list2 = getAllPlayers()
        local plr = list2[spectatingIndex]
        if not plr then return end
        local char = plr.Character
        if not char then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local hum = char:FindFirstChildOfClass("Humanoid")
        local inVehicle = hum ~= nil and hum.SeatPart ~= nil

        -- Punto de referencia: la cabeza si existe (para la altura real
        -- del piloto), si no el HumanoidRootPart.
        local head = char:FindFirstChild("Head")
        local refPart = head or hrp

        -- Direccion "hacia adelante" en el plano horizontal (sin inclinacion),
        -- tomada del HumanoidRootPart, que es estable y gira con el cuerpo
        -- (y con el auto, cuando esta sentado en uno).
        local lookVector = hrp.CFrame.LookVector
        local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
        if flatLook.Magnitude < 0.001 then
            flatLook = Vector3.new(0, 0, -1)
        else
            flatLook = flatLook.Unit
        end

        local headPos = refPart.Position

        -- Altura de la camara: muy por encima de la cabeza, como una
        -- camara de casco F1 vista desde arriba/atras (no a la altura
        -- de los ojos). Si esta en vehiculo, subimos un poco mas para
        -- despejar el techo/alerones del auto.
        local heightAbove = inVehicle and 3.0 or 2.2
        local backDistance = 1.0

        local camPos = headPos
            + Vector3.new(0, heightAbove, 0)
            - (flatLook * backDistance)

        -- El punto de mira esta adelante y un poco mas abajo que la camara,
        -- para que se vea el casco del piloto en la parte baja del encuadre
        -- y el camino/auto por delante (igual que un onboard real de F1).
        local lookPos = headPos
            + Vector3.new(0, heightAbove - 1.4, 0)
            + (flatLook * 15)

        Camera.CFrame = CFrame.new(camPos, lookPos)
    end)
end

