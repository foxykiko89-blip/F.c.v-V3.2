diagBtn.MouseButton1Click:Connect(function()
    if diagFrame.Visible then diagFrame.Visible = false; diagBtn.Text = "Diagnostico de mi auto"; return end
    local lines = {}
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not isInVehicleSeat(hum) then
        lines[1] = "Sube a un auto y vuelve a pulsar."
    else
        local seat = hum.SeatPart
        local model = getPlayerVehicleModel(LocalPlayer) or seat:FindFirstAncestorOfClass("Model")
        local function dumpAttrs(inst, label)
            local okA, attrs = pcall(function() return inst:GetAttributes() end)
            if okA and attrs then
                for an, av in pairs(attrs) do
                    table.insert(lines, "[attr] " .. label .. "." .. an .. " = " .. tostring(av))
                end
            end
        end
        table.insert(lines, "Auto: " .. (model and model.Name or "?") .. " | Asiento: " .. seat.Name)
        dumpAttrs(seat, seat.Name)
        if model then
            local kids = {}
            for _, k in ipairs(model:GetChildren()) do
                if #kids >= 40 then break end
                table.insert(kids, k.Name .. ":" .. k.ClassName)
            end
            table.insert(lines, "[hijos] " .. table.concat(kids, ", "))
            dumpAttrs(model, model.Name)
            local springs, sumFL, sumSt = 0, 0, 0
            for _, d in ipairs(model:GetDescendants()) do
                if #lines > 260 then break end
                if isValueObj(d) or d:IsA("BoolValue") then
                    table.insert(lines, "[val] " .. d.Name .. " = " .. tostring(d.Value))
                elseif d:IsA("SpringConstraint") then
                    springs = springs + 1
                    sumFL = sumFL + d.FreeLength
                    sumSt = sumSt + d.Stiffness
                end
                dumpAttrs(d, d.Name)
            end
            if springs > 0 then
                table.insert(lines, string.format("[resortes] %d | FreeLength prom = %.3f | Stiffness prom = %.1f", springs, sumFL / springs, sumSt / springs))
            end
        end
        if #lines <= 1 then table.insert(lines, "El auto no expone Values ni Atributos.") end
    end
    diagText.Text = table.concat(lines, "\n")
    diagFrame.CanvasSize = UDim2.new(0,0,0, 20 + #lines * 14)
    diagFrame.Visible = true
    diagBtn.Text = "Cerrar diagnostico"
end)

