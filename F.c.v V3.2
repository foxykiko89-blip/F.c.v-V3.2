updateFastLapPanel = function()
    if not fastLapOverallBest then
        fastLapLabel.Text = "Sin vueltas registradas"
        return
    end
    local lines = "MEJOR: " .. fastLapOverallBest.name .. " - " .. formatTime(fastLapOverallBest.time) .. "\n"
    local personal = {}
    for _, plr in ipairs(getAllPlayers()) do
        if fastLapTimes[plr.UserId] then
            table.insert(personal, { name = dn(plr), time = fastLapTimes[plr.UserId] })
        end
    end
    table.sort(personal, function(a, b) return a.time < b.time end)
    for _, entry in ipairs(personal) do
        lines = lines .. entry.name .. ": " .. formatTime(entry.time) .. "\n"
    end
    fastLapLabel.Text = lines
end

fastLapResetBtn.MouseButton1Click:Connect(function()
    fastLapTimes = {}
    fastLapOverallBest = nil
    playerLastMetaCrossTick = {}
    updateFastLapPanel()
    logEvent("FAST LAP: reiniciado por el director de carrera")
    sendDiscordEvent(":arrows_counterclockwise: **Fast Lap** reiniciado por el director de carrera")
end)

